# Local development with `npm run dev`
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# API base URL for local development (`npm run dev` / `wrangler dev`)
VITE_API_URL=http://localhost:8787
# Optional (not required for Google sign-in):
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=

# Production: set the same variable names in the Cloudflare Workers dashboard
# (Workers & Pages > bookmark-web-ui > Settings > Variables and Secrets).
# Do not commit production values to the repository.
