{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bookmark-web-ui",
  "compatibility_date": "2026-07-17",
  "observability": {
    "enabled": true
  },
  "main": "./workers/app.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ]
  // Production Firebase config: set VITE_FIREBASE_* in the Cloudflare dashboard.
  // Local wrangler dev/preview: copy .dev.vars.example to .dev.vars.
}
